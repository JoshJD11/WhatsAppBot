# Copy this file to .env and fill in the values. Never commit .env.

# WhatsApp Cloud API (Meta app dashboard > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app dashboard > App settings > Basic > App secret. Used to verify webhook signatures.
META_APP_SECRET=
# Any long random string. Paste the same value in the webhook settings in Meta.
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v26.0

# One-time Embedded Signup that connects the real business number (coexistence).
# /signup is off unless all three are set. Clear SIGNUP_KEY once the number is connected.
# Meta app dashboard > App settings > Basic > App ID
META_APP_ID=
# Meta app dashboard > Facebook Login for Business > Configurations > WhatsApp Embedded Signup
SIGNUP_CONFIG_ID=
# Long random string (32+ characters), e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# Open https://<NGROK_DOMAIN>/signup?key=<SIGNUP_KEY>
SIGNUP_KEY=

# Google Gemini (https://aistudio.google.com/apikey). If empty, AI mode always falls back to the menu.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal, low, medium or high
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=20

# Excel source: "drive" (production) or "local" (development, no Google setup needed)
EXCEL_SOURCE=local
EXCEL_LOCAL_PATH=data/bosca_bot.xlsx
# For EXCEL_SOURCE=drive: the ID in the file URL (drive.google.com/file/d/<ID>/view)
DRIVE_FILE_ID=
# Path to the service account JSON key. Keep it outside the repository or in credentials/ (ignored by git).
GOOGLE_SERVICE_ACCOUNT_FILE=
EXCEL_RELOAD_MINUTES=10

# Mode at startup: "ai" or "rule". Admin commands change it while running.
BOT_MODE=rule
# Numbers allowed to send #bosca commands, comma separated, with country code.
ADMIN_NUMBERS=50671413393
# Number that receives handoff notifications (only while its 24 hour window is open).
OWNER_NUMBER=50671413393

HANDOFF_PAUSE_MINUTES=60
RATE_LIMIT_MAX_MESSAGES=8
RATE_LIMIT_WINDOW_SECONDS=60
AI_HISTORY_MESSAGES=10
AI_HISTORY_IDLE_MINUTES=30
TIMEZONE=America/Costa_Rica
# Saves the mode, handoff pauses and the owner's last message time so a restart keeps them.
# Leave empty to keep everything in memory only.
STATE_FILE=data/state.json
LOG_LEVEL=INFO

# ngrok static domain claimed in the ngrok dashboard (domain only, no https://). Used by scripts/start.sh.
NGROK_DOMAIN=your-name.ngrok-free.app
